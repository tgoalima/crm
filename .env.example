# .env.example — variáveis necessárias pra rodar server.py (dev local) e as
# Edge Functions (supabase/functions/). Copie pra .env e preencha; nunca
# commite o .env de verdade (já está no .gitignore).

# Supabase (self-hosted, https://supabase.llworkflow.com.br)
SUPABASE_URL=https://supabase.llworkflow.com.br
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ClickUp — token global de fallback (usado quando o usuário logado não tem
# token pessoal salvo em usuarios_clickup, ver supabase/functions/_shared/resolve-token.ts)
CLICKUP_TOKEN=
CLICKUP_API_TOKEN=
CLICKUP_CUSTOM_FIELD_ID=
CLICKUP_PROPOSTA_FIELD_ID=

# Chave usada pra criptografar (AES-GCM) os tokens pessoais do ClickUp antes
# de gravar em usuarios_clickup — ver supabase/functions/save-clickup-credentials
TOKEN_ENCRYPTION_KEY=

# Autenticação do endpoint mcp-brain (integração ClickUp Brain via MCP)
MCP_AUTH_KEY=
